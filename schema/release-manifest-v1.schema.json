{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cowebslb.com/developer-setup/release-manifest-v1.schema.json",
  "title": "COWebs.lb Developer Setup release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "sourceCommit", "publishedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "sourceCommit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "platform", "architecture", "url", "sha256", "sizeBytes", "minimumEnvironment"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["windows", "macos", "linux", "portable"] },
          "architecture": { "enum": ["x86", "x64", "arm64", "any"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "minimumEnvironment": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "minLength": 1 },
          "certificateIdentity": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
